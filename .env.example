# Released Configuration
# Copy this file to .env and fill in your actual values.
# Variable names follow the tap's setting keys; run `tap-released --about` for the
# authoritative list.

# Required: Long-lived Bearer access token for the Released API
TAP_RELEASED_ACCESS_TOKEN=your_access_token_here

# Optional: The earliest record date to sync (ISO-8601)
TAP_RELEASED_START_DATE=2023-01-01T00:00:00Z

# Optional: API base URL (defaults to https://api.re-leased.com/api)
TAP_RELEASED_API_URL=https://api.re-leased.com/api
